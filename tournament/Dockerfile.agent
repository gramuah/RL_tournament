FROM python:3.11.15-slim-bookworm@sha256:77923445c077d8eb971b14b2b114a1d9cd4a87edb4c75654820ca4832ee8cb15
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
COPY requirements-agent.lock /opt/requirements-agent.lock
RUN pip install --no-cache-dir --require-hashes -r /opt/requirements-agent.lock
COPY sandbox_agent.py browser_model.py /opt/
USER 65534:65534
WORKDIR /submission
ENTRYPOINT ["python", "-I", "/opt/sandbox_agent.py"]
